<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="planage.PlanageSystrayItem" owl="1">
        <div class="o_nav_entry">
            <Dropdown position="'bottom-end'" beforeOpen.bind="onBeforeOpen">
                <!-- Systray Navbar Icon (Toggler) -->
                <button class="btn btn-link dropdown-toggle d-flex align-items-center position-relative" style="color: inherit; text-decoration: none;">
                    <i class="fa fa-lg fa-rocket" role="img" aria-label="Planage Notifications"></i>
                    <span t-if="state.unreadCount > 0" class="o_notification_counter badge rounded-pill bg-danger position-absolute" style="top: 0px; right: 0px; transform: translate(30%, 0%); font-size: 0.5rem; padding: 2px 4px; line-height: 1;">
                        <t t-esc="state.unreadCount"/>
                    </span>
                </button>
                
                <!-- Dropdown Content -->
                <t t-set-slot="content">
                <div class="o_mail_systray_dropdown_top d-flex justify-content-between align-items-center p-2 border-bottom">
                    <span class="fw-bold px-2">Planage Notifications</span>
                    <div class="d-flex align-items-center gap-3 pe-2">
                        <button class="btn btn-link btn-sm text-muted p-0" t-on-click="markAllAsRead" title="Mark All as Read">
                            <i class="fa fa-check-double fa-lg"></i>
                        </button>
                        <button class="btn btn-link btn-sm text-primary p-0" t-on-click="() => this.openPlanage()" title="Open Planage">
                            <i class="fa fa-external-link fa-lg"></i>
                        </button>
                    </div>
                </div>
                
                <div class="o_mail_systray_dropdown_items" style="max-height: 400px; overflow-y: auto;">
                    <t t-if="state.notifications.length === 0">
                        <div class="p-4 text-center text-muted">
                            <i class="fa fa-smile-o fa-2x mb-2 d-block"></i>
                            All caught up!
                        </div>
                    </t>
                    <t t-else="">
                        <t t-foreach="state.notifications.slice(0, 5)" t-as="notif" t-key="notif.id">
                            <div class="p-2 border-bottom dropdown-item d-flex align-items-start" t-att-class="{'bg-light': !notif.read}" t-on-click="() => this.openPlanage(notif)" style="cursor: pointer; white-space: normal;">
                                <div class="me-3 mt-1">
                                    <i t-if="notif.type === 'mention'" class="fa fa-at text-info"></i>
                                    <i t-elif="notif.type === 'task_assigned'" class="fa fa-user-plus text-success"></i>
                                    <i t-elif="notif.type === 'sprint_started'" class="fa fa-play text-primary"></i>
                                    <i t-else="" class="fa fa-bell text-warning"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between">
                                        <strong t-esc="notif.title" class="text-truncate" style="max-width: 200px;"/>
                                        <small class="text-muted" t-esc="notif.create_date"/>
                                    </div>
                                    <div class="text-muted small mt-1" t-esc="notif.message"/>
                                </div>
                                <div t-if="!notif.read" class="ms-2 mt-2">
                                    <div class="bg-primary rounded-circle" style="width: 8px; height: 8px;"></div>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>
            </t>
        </Dropdown>
        </div>
    </t>

</templates>
