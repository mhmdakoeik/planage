<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Membership isolation: a Space is visible to everyone when it has no
            explicit user_ids (public workspace), otherwise only to its members.
            Every other model below is scoped transitively through its Space.
            Managers/Admins get an unrestricted rule that ORs with the
            restrictive one (both are group-scoped), so they always see everything.
        -->

        <record id="rule_planage_space_member" model="ir.rule">
            <field name="name">Planage Space: member or public only</field>
            <field name="model_id" ref="model_planage_space"/>
            <field name="groups" eval="[(4, ref('group_planage_user'))]"/>
            <field name="domain_force">['|', ('user_ids', '=', False), ('user_ids', 'in', [user.id])]</field>
        </record>
        <record id="rule_planage_space_manager" model="ir.rule">
            <field name="name">Planage Space: manager full access</field>
            <field name="model_id" ref="model_planage_space"/>
            <field name="groups" eval="[(4, ref('group_planage_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_planage_folder_member" model="ir.rule">
            <field name="name">Planage Folder: member or public only</field>
            <field name="model_id" ref="model_planage_folder"/>
            <field name="groups" eval="[(4, ref('group_planage_user'))]"/>
            <field name="domain_force">['|', ('space_id.user_ids', '=', False), ('space_id.user_ids', 'in', [user.id])]</field>
        </record>
        <record id="rule_planage_folder_manager" model="ir.rule">
            <field name="name">Planage Folder: manager full access</field>
            <field name="model_id" ref="model_planage_folder"/>
            <field name="groups" eval="[(4, ref('group_planage_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

